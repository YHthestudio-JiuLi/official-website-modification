{
  "name": "yhthestudio-web",
  "version": "2.1.5",
  "description": "YHthestudio - Vue 3 E-commerce & Forum Platform",
  "main": "api-server.js",
  "scripts": {
    "py": ".venv/bin/python -m uvicorn py_backend.main:app --host 127.0.0.1 --port 5100 --reload",
    "laravel": "bash scripts/laravel-serve.sh",
    "laravel:setup": "bash scripts/laravel-setup.sh",
    "deploy": "bash scripts/deploy.sh",
    "validate": "bash scripts/validate-migration.sh",
    "test:product-config": "node server/tests/productConfig.test.js",
    "test:agent-scope": "node server/tests/agentDataScope.test.js && node server/tests/bridge-token.test.js",
    "dev": "npm run build && npm start",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node api-server.js"
  },
  "keywords": [
    "yhthestudio",
    "vue3",
    "ecommerce",
    "forum",
    "fastapi"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.3.1",
    "element-plus": "^2.14.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.17.3",
    "form-data": "^4.0.5",
    "hpagent": "^1.2.0",
    "multer": "^2.1.1",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.6.4",
    "winston": "^3.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild": "^0.28.0",
    "vite": "^7.3.1"
  }
}
