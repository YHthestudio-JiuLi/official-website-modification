<%- include('partials/admin-header', { title: post ? '编辑帖子' : '添加帖子', pageTitle: post ? '编辑帖子' : '添加帖子', currentPage: 'posts', admin: admin }) %>

<div class="admin-page-header">
    <h2><i class="fas fa-comments"></i> <%= post ? '编辑帖子' : '添加帖子' %></h2>
    <a href="/admin/posts" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> 返回列表
    </a>
</div>

<div class="admin-form-container">
    <form action="/admin/posts/save" method="POST" class="admin-form">
        <% if (post) { %>
            <input type="hidden" name="id" value="<%= post.id %>">
        <% } %>
        <div class="form-group">
            <label for="title">
                <i class="fas fa-heading"></i> 标题 *
            </label>
            <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required>
        </div>
        <div class="form-group">
            <label for="author">
                <i class="fas fa-user"></i> 作者 *
            </label>
            <input type="text" id="author" name="author" value="<%= post ? post.author : 'Admin' %>" required>
        </div>
        <div class="form-group">
            <label for="content">
                <i class="fas fa-align-left"></i> 内容 *
            </label>
            <textarea id="content" name="content" rows="10" required><%= post ? post.content : '' %></textarea>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="date">
                    <i class="fas fa-calendar"></i> 发布日期 *
                </label>
                <input type="date" id="date" name="date" value="<%= post ? post.date : new Date().toISOString().split('T')[0] %>" required>
            </div>
            <div class="form-group">
                <label for="replies">
                    <i class="fas fa-comments"></i> 回复数
                </label>
                <input type="number" id="replies" name="replies" value="<%= post ? post.replies : 0 %>" min="0">
            </div>
        </div>
        <div class="form-actions">
            <a href="/admin/posts" class="btn btn-secondary">取消</a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> 保存
            </button>
        </div>
    </form>
</div>

<%- include('partials/admin-footer') %>
