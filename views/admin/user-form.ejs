<%- include('partials/admin-header', { title: user ? '编辑用户' : '添加用户', pageTitle: user ? '编辑用户' : '添加用户', currentPage: 'users', admin: admin }) %>

<div class="admin-page-header">
    <h2><i class="fas fa-user"></i> <%= user ? '编辑用户' : '添加用户' %></h2>
    <a href="/admin/users" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> 返回列表
    </a>
</div>

<div class="admin-form-container">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> <%= error %>
        </div>
    <% } %>
    <form action="/admin/users/save" method="POST" class="admin-form">
        <% if (user) { %>
            <input type="hidden" name="id" value="<%= user.id %>">
        <% } %>
        <div class="form-group">
            <label for="username">
                <i class="fas fa-user"></i> 用户名 *
            </label>
            <input type="text" id="username" name="username" value="<%= user ? user.username : '' %>" required <%= user ? 'readonly' : '' %>>
            <% if (user) { %>
                <small class="form-hint">用户名不可修改</small>
            <% } %>
        </div>
        <div class="form-group">
            <label for="email">
                <i class="fas fa-envelope"></i> 邮箱 *
            </label>
            <input type="email" id="email" name="email" value="<%= user ? user.email : '' %>" required>
        </div>
        <div class="form-group">
            <label for="password">
                <i class="fas fa-lock"></i> 密码 <%= user ? '(留空则不修改)' : '*' %>
            </label>
            <input type="password" id="password" name="password" <%= user ? '' : 'required' %>>
            <% if (user) { %>
                <small class="form-hint">如果不需要修改密码，请留空</small>
            <% } %>
        </div>
        <div class="form-group">
            <label for="isAdmin">
                <i class="fas fa-shield-alt"></i> 管理员权限
            </label>
            <select id="isAdmin" name="isAdmin">
                <option value="0" <%= user && !user.isAdmin ? 'selected' : '' %>>普通用户</option>
                <option value="1" <%= user && user.isAdmin ? 'selected' : '' %>>管理员</option>
            </select>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> 保存
            </button>
            <a href="/admin/users" class="btn btn-secondary">
                <i class="fas fa-times"></i> 取消
            </a>
        </div>
    </form>
</div>

<style>
.form-hint {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

input[readonly] {
    background: var(--bg-dark);
    cursor: not-allowed;
    opacity: 0.7;
}
</style>

<%- include('partials/admin-footer') %>

