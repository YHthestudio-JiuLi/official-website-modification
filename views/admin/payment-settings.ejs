<%- include('partials/admin-header', { title: typeof t !== 'undefined' ? t('admin.paymentSettings.title') : 'Payment Settings', pageTitle: typeof t !== 'undefined' ? t('admin.paymentSettings.title') : 'Payment Settings', currentPage: 'payment-settings', admin: admin, t: typeof t !== 'undefined' ? t : null, lang: typeof lang !== 'undefined' ? lang : 'en' }) %>

<div class="admin-page-header">
    <h2><i class="fas fa-wallet"></i> <%= typeof t !== 'undefined' ? t('admin.paymentSettings.title') : 'Payment Settings' %></h2>
    <p><%= typeof t !== 'undefined' ? t('admin.paymentSettings.description') : 'Configure USDT wallet address and order auto-delete settings' %></p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error">
        <i class="fas fa-exclamation-circle"></i> <%= error %>
    </div>
<% } %>

<div class="admin-form-container">
    <form action="/admin/payment-settings" method="POST" class="admin-form">
        <div class="form-group">
            <label for="wallet_address">
                <i class="fab fa-bitcoin"></i> <%= typeof t !== 'undefined' ? t('admin.paymentSettings.walletAddress') : 'USDT Wallet Address' %> (TRC20) *
            </label>
            <input type="text" id="wallet_address" name="wallet_address" 
                   value="<%= settings ? settings.wallet_address : '' %>" 
                   required placeholder="Enter TRC20 network wallet address">
            <small>This address will be used to receive USDT payments from users</small>
        </div>
        
        <div class="form-group">
            <label for="network">
                <i class="fas fa-network-wired"></i> <%= typeof t !== 'undefined' ? t('admin.paymentSettings.network') : 'Network' %>
            </label>
            <select id="network" name="network" class="form-select">
                <option value="TRC20" <%= settings && settings.network === 'TRC20' ? 'selected' : '' %>>TRC20 (Tron)</option>
                <option value="ERC20" <%= settings && settings.network === 'ERC20' ? 'selected' : '' %>>ERC20 (Ethereum)</option>
                <option value="BEP20" <%= settings && settings.network === 'BEP20' ? 'selected' : '' %>>BEP20 (BSC)</option>
            </select>
            <small>Select the blockchain network where USDT is located</small>
        </div>
        
        <div class="form-group">
            <label for="autoDeleteMinutes">
                <i class="fas fa-clock"></i> <%= typeof t !== 'undefined' ? t('admin.paymentSettings.autoDeleteMinutes') : 'Auto Delete Minutes' %> (minutes)
            </label>
            <input type="number" id="autoDeleteMinutes" name="autoDeleteMinutes" 
                   value="<%= settings ? (settings.autoDeleteMinutes || 30) : 30 %>" 
                   min="1" required class="form-input">
            <small>Orders that remain unpaid beyond this time will be automatically deleted (default: 30 minutes)</small>
        </div>
        
        <% if (settings && settings.updatedAt) { %>
        <div class="form-info">
            <i class="fas fa-info-circle"></i>
            Last Updated: <%= new Date(settings.updatedAt).toLocaleString('en-US') %>
        </div>
        <% } %>
        
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> <%= typeof t !== 'undefined' ? t('admin.paymentSettings.save') : 'Save Settings' %>
            </button>
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </form>
</div>

<style>
.admin-form-container {
    max-width: 600px;
    margin: 2rem auto;
}

.admin-form {
    background: var(--bg-card);
    padding: 2rem;
    border-radius: 10px;
    border: 1px solid var(--border-color);
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 500;
}

.form-group label i {
    margin-right: 0.5rem;
    color: var(--primary-color);
}

.form-group input[type="text"],
.form-group input[type="number"],
.form-select {
    width: 100%;
    padding: 0.8rem;
    background: var(--bg-dark);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    color: var(--text-primary);
    font-size: 1rem;
}

.form-group input[type="text"]:focus,
.form-group input[type="number"]:focus,
.form-select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(0, 212, 255, 0.2);
}

.form-group small {
    display: block;
    margin-top: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
}

.form-info {
    padding: 1rem;
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid var(--primary-color);
    border-radius: 5px;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
}

.form-info i {
    margin-right: 0.5rem;
    color: var(--primary-color);
}

.form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
}

.btn {
    padding: 0.8rem 1.5rem;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary {
    background: var(--primary-color);
    color: white;
}

.btn-primary:hover {
    background: #00b8e6;
    transform: translateY(-2px);
}

.btn-secondary {
    background: var(--bg-dark);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background: var(--bg-card);
    border-color: var(--primary-color);
}
</style>

<%- include('partials/admin-footer') %>

