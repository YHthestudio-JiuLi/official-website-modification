# 服务器配置
PORT=3000
HOST=0.0.0.0

# Session 配置
SESSION_SECRET=your-secret-key-here

# 数据库配置
YH_DB_PATH=data/yhthestudio.db
PY_DB_URL=http://127.0.0.1:5100

# 支付配置
DEFAULT_WALLET_ADDRESS=TXYZabcdefghijklmnopqrstuvwxyz123456
DEFAULT_NETWORK=TRC20
AUTO_DELETE_MINUTES=30

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/combined.log
LOG_ERROR_FILE=logs/error.log

# Telegram 配置（客服聊天推送到 Telegram）
# 1. 联系 @BotFather 创建机器人，获取 BOT TOKEN
# 2. 给你的机器人发送任意消息（如 /start）
# 3. 访问 https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates 获取你的 chat_id
# 4. 将 chat_id 填入 TELEGRAM_CHAT_ID
# 注意：中国大陆需要配置代理才能连接 Telegram
TELEGRAM_BOT_TOKEN=8370537685:AAHT_Phb88J62gvDziXgMBRjXiIeYmayl8E
TELEGRAM_CHAT_ID=8571640485
TELEGRAM_USE_POLLING=true
TELEGRAM_WEBHOOK_SECRET=
# 代理配置（根据当地网络环境配置，Clash 通常使用 7890 端口）
TELEGRAM_PROXY=http://127.0.0.1:7890
