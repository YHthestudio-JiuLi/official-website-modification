<%- include('partials/header', { title: 'Forum', user: user }) %>

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-comments"></i> Tech Forum</h1>
        <p>Share knowledge, exchange experiences, grow together</p>
        <% if (typeof user !== 'undefined' && user) { %>
            <a href="/forum/post" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Post
            </a>
        <% } else { %>
            <a href="/login" class="btn btn-primary">
                <i class="fas fa-sign-in-alt"></i> Login to Post
            </a>
        <% } %>
    </div>
</div>

<div class="forum-page">
    <div class="container">
        <div class="forum-posts">
            <% posts.forEach(function(post) { %>
                <div class="forum-post-card <%= post.isPinned ? 'pinned-post' : '' %>">
                    <div class="post-header">
                        <h3>
                            <% if (post.isPinned) { %>
                                <i class="fas fa-thumbtack pinned-icon" title="Pinned"></i>
                            <% } %>
                            <a href="/forum/<%= post.id %>"><%= post.title %></a>
                        </h3>
                        <span class="post-date"><i class="fas fa-calendar"></i> <%= post.date %></span>
                    </div>
                    <div class="post-content">
                        <p><%= post.content %></p>
                    </div>
                    <div class="post-footer">
                        <span class="post-author">
                            <i class="fas fa-user"></i> <%= post.author %>
                        </span>
                        <span class="post-replies">
                            <i class="fas fa-comments"></i> <%= post.replies %> replies
                        </span>
                        <span class="post-actions">
                            <a href="/forum/<%= post.id %>" class="btn btn-secondary btn-sm">View</a>
                            <% if (typeof user !== 'undefined' && user) { %>
                                <a href="/forum/<%= post.id %>#reply" class="btn btn-primary btn-sm">
                                    <i class="fas fa-reply"></i> Reply
                                </a>
                            <% } %>
                        </span>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
