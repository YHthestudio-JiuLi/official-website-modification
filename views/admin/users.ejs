<%- include('partials/admin-header', { title: typeof t !== 'undefined' ? t('admin.users.title') : '用户管理', pageTitle: typeof t !== 'undefined' ? t('admin.users.title') : '用户管理', currentPage: 'users', admin: admin, t: typeof t !== 'undefined' ? t : null, lang: typeof lang !== 'undefined' ? lang : 'en' }) %>

<div class="admin-page-header">
    <h2><i class="fas fa-users"></i> <%= typeof t !== 'undefined' ? t('admin.users.listTitle') : '用户列表' %></h2>
    <p><%= typeof t !== 'undefined' ? t('admin.users.description') : '管理系统中的所有用户账号' %></p>
</div>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th><%= typeof t !== 'undefined' ? t('admin.users.id') : 'ID' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.users.username') : '用户名' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.users.email') : '邮箱' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.users.registerTime') : '注册时间' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.users.isAdmin') : '管理员' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.users.actions') : '操作' %></th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(function(user) { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString(typeof lang !== 'undefined' && lang === 'zh' ? 'zh-CN' : 'en-US') : '-' %></td>
                    <td>
                        <% if (user.isAdmin) { %>
                            <span class="badge badge-success"><%= typeof t !== 'undefined' ? t('admin.users.yes') : '是' %></span>
                        <% } else { %>
                            <span class="badge"><%= typeof t !== 'undefined' ? t('admin.users.no') : '否' %></span>
                        <% } %>
                    </td>
                    <td>
                        <a href="/admin/users/edit/<%= user.id %>" class="btn btn-secondary btn-sm">
                            <i class="fas fa-edit"></i> <%= typeof t !== 'undefined' ? t('admin.users.edit') : '修改' %>
                        </a>
                        <% if (!user.isAdmin) { %>
                            <form action="/admin/users/delete/<%= user.id %>" method="POST" style="display: inline;" onsubmit="return confirm('<%= typeof t !== 'undefined' ? t('admin.users.confirmDelete') : '确定要删除此用户吗？' %>');">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> <%= typeof t !== 'undefined' ? t('admin.users.delete') : '删除' %>
                                </button>
                            </form>
                        <% } else { %>
                            <span class="text-muted" style="margin-left: 0.5rem;"><%= typeof t !== 'undefined' ? t('admin.users.cannotDelete') : '不可删除' %></span>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
            <% if (users.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center"><%= typeof t !== 'undefined' ? t('admin.users.empty') : '暂无用户' %></td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/admin-footer') %>
