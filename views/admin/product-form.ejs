<%- include('partials/admin-header', { title: product ? '编辑产品' : '添加产品', pageTitle: product ? '编辑产品' : '添加产品', currentPage: 'products', admin: admin }) %>

<div class="admin-page-header">
    <h2><i class="fas fa-box"></i> <%= product ? '编辑产品' : '添加产品' %></h2>
    <a href="/admin/products" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> 返回列表
    </a>
</div>

<div class="admin-form-container">
    <form action="/admin/products/save" method="POST" class="admin-form">
        <% if (product) { %>
            <input type="hidden" name="id" value="<%= product.id %>">
        <% } %>
        <div class="form-group">
            <label for="name">
                <i class="fas fa-tag"></i> 产品名称 *
            </label>
            <input type="text" id="name" name="name" value="<%= product ? product.name : '' %>" required>
        </div>
        <div class="form-group">
            <label for="description">
                <i class="fas fa-align-left"></i> 产品描述 *
            </label>
            <textarea id="description" name="description" rows="4" required><%= product ? product.description : '' %></textarea>
        </div>
        <div class="form-group">
            <label for="image">
                <i class="fas fa-image"></i> 图片URL *
            </label>
            <input type="url" id="image" name="image" value="<%= product ? product.image : '' %>" required>
            <% if (product && product.image) { %>
                <div class="image-preview">
                    <img src="<%= product.image %>" alt="预览">
                </div>
            <% } %>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="date">
                    <i class="fas fa-calendar"></i> 发布日期 *
                </label>
                <input type="date" id="date" name="date" value="<%= product ? product.date : new Date().toISOString().split('T')[0] %>" required>
            </div>
            <div class="form-group">
                <label for="priceUsdt">
                    <i class="fab fa-bitcoin"></i> 价格 (USDT) *
                </label>
                <input type="number" id="priceUsdt" name="priceUsdt" value="<%= product ? (product.priceUsdt || product.price || 0) : 0 %>" step="0.01" min="0" required>
            </div>
        </div>
        <div class="form-actions">
            <a href="/admin/products" class="btn btn-secondary">取消</a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> 保存
            </button>
        </div>
    </form>
</div>

<%- include('partials/admin-footer') %>
