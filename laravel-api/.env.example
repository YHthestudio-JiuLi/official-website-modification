APP_NAME=YHthestudio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yhthestudio.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

# 与主项目共用 MySQL（与 Node/Python 同一库）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yhthestudio_web
DB_USERNAME=root
DB_PASSWORD=

# Session / 缓存（生产强烈建议 Redis）
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# 仅填域名，带前导点可共享子域；勿写 https://
SESSION_DOMAIN=.yhthestudio.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum SPA 域名（逗号分隔）
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,yhthestudio.com,www.yhthestudio.com

# CORS
CORS_ALLOWED_ORIGINS=https://yhthestudio.com,http://localhost:5173,http://127.0.0.1:5173

# 管理端 IP 白名单（留空不限制，示例：123.45.67.89,10.0.0.1）
ADMIN_IP_WHITELIST=

# 尚未移植的接口（聊天、设备验签）转发目标；上传/Telegram 仍经 Node
LEGACY_NODE_URL=http://127.0.0.1:3000
# Laravel 回调 Node 发送论坛/订单 Telegram（须与主项目 .env 中 NODE_INTERNAL_SECRET 一致）
NODE_INTERNAL_SECRET=change-me-to-a-long-random-string
# 题库/固件/设备管理等经 Python RPC（须与 yh-py 同机 127.0.0.1:5100）
PY_DB_URL=http://127.0.0.1:5100

LOG_CHANNEL=stack
LOG_LEVEL=info

BCRYPT_ROUNDS=12

# 顺丰丰桥路由查询 EXP_RECE_SEARCH_ROUTES（可选）
# SF_PARTNER_ID=顾客编码
# SF_CHECK_WORD=沙箱或生产校验码
# SF_SANDBOX=true
