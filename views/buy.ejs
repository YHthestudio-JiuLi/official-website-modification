<%- include('partials/header', { title: 'Buy Product', user: user }) %>

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-shopping-cart"></i> Buy Product</h1>
    </div>
</div>

<div class="product-detail-page">
    <div class="container">
        <div class="product-detail-grid">
            <div class="product-detail-image">
                <img src="<%= product.image %>" alt="<%= product.name %>">
            </div>
            <div class="product-detail-info">
                <h2><%= product.name %></h2>
                <p class="product-description"><%= product.description %></p>
                
                <div class="product-detail-meta">
                    <div class="meta-item">
                        <i class="fas fa-calendar"></i>
                        <span>Release Date: <%= product.date %></span>
                    </div>
                </div>
                
                <div class="product-detail-price">
                    <span class="price-label">Unit Price: </span>
                    <span class="price-amount-large"><%= product.priceUsdt || product.price || 0 %> USDT</span>
                </div>
                
                <form action="/orders/create" method="POST" class="buy-form">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    
                    <div class="form-group">
                        <label for="quantity">
                            <i class="fas fa-hashtag"></i> Purchase Quantity
                        </label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" required>
                    </div>
                    
                    <div class="order-summary">
                        <h3>Order Summary</h3>
                        <div class="summary-item">
                            <span>Product: </span>
                            <span><%= product.name %></span>
                        </div>
                        <div class="summary-item">
                            <span>Unit Price: </span>
                            <span><%= product.priceUsdt || product.price || 0 %> USDT</span>
                        </div>
                        <div class="summary-item">
                            <span>Quantity: </span>
                            <span id="summary-quantity">1</span>
                        </div>
                        <div class="summary-item total">
                            <span>Total: </span>
                            <span id="summary-total"><%= product.priceUsdt || product.price || 0 %> USDT</span>
                        </div>
                    </div>
                    
                    <div class="payment-method">
                        <h3><i class="fab fa-bitcoin"></i> Payment Method</h3>
                        <div class="payment-option selected">
                            <i class="fab fa-bitcoin"></i>
                            <span>USDT (<%= typeof paymentSettings !== 'undefined' && paymentSettings ? paymentSettings.network : 'TRC20' %>)</span>
                            <span class="check-icon"><i class="fas fa-check"></i></span>
                        </div>
                        <p class="payment-note">Only USDT (<%= typeof paymentSettings !== 'undefined' && paymentSettings ? paymentSettings.network : 'TRC20' %>) payment is supported</p>
                    </div>
                    
                    <div class="product-detail-actions">
                        <button type="submit" class="btn btn-primary btn-large">
                            <i class="fas fa-credit-card"></i> Confirm Purchase
                        </button>
                        <a href="/products/<%= product.id %>" class="btn btn-secondary btn-large">
                            <i class="fas fa-arrow-left"></i> Back to Product
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const quantityInput = document.getElementById('quantity');
    const summaryQuantity = document.getElementById('summary-quantity');
    const summaryTotal = document.getElementById('summary-total');
    const price = <%= product.priceUsdt || product.price || 0 %>;
    
    quantityInput.addEventListener('input', function() {
        const qty = parseInt(this.value) || 1;
        summaryQuantity.textContent = qty;
        summaryTotal.textContent = (price * qty).toFixed(2) + ' USDT';
    });
});
</script>

<%- include('partials/footer') %>

