<%- include('partials/admin-header', { title: typeof t !== 'undefined' ? t('admin.posts.title') : 'Forum Management', pageTitle: typeof t !== 'undefined' ? t('admin.posts.title') : 'Forum Management', currentPage: 'posts', admin: admin, t: typeof t !== 'undefined' ? t : null, lang: typeof lang !== 'undefined' ? lang : 'en' }) %>

<div class="admin-page-header">
    <h2><i class="fas fa-comments"></i> <%= typeof t !== 'undefined' ? t('admin.posts.listTitle') : 'Forum Posts' %></h2>
    <a href="/admin/posts/add" class="btn btn-primary">
        <i class="fas fa-plus"></i> <%= typeof t !== 'undefined' ? t('admin.posts.addPost') : 'Add Post' %>
    </a>
</div>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th><%= typeof t !== 'undefined' ? t('admin.posts.id') : 'ID' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.posts.title') : 'Title' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.posts.author') : 'Author' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.posts.date') : 'Date' %></th>
                <th><%= typeof t !== 'undefined' ? t('admin.posts.replies') : 'Replies' %></th>
                <th>Status</th>
                <th><%= typeof t !== 'undefined' ? t('admin.posts.actions') : 'Actions' %></th>
            </tr>
        </thead>
        <tbody>
            <% posts.forEach(function(post) { %>
                <tr>
                    <td><%= post.id %></td>
                    <td>
                        <% if (post.isPinned) { %>
                            <i class="fas fa-thumbtack" style="color: var(--primary-color); margin-right: 5px;"></i>
                        <% } %>
                        <%= post.title.length > 30 ? post.title.substring(0, 30) + '...' : post.title %>
                    </td>
                    <td><%= post.author %></td>
                    <td><%= post.date %></td>
                    <td><%= post.replies %></td>
                    <td>
                        <% if (post.isPinned) { %>
                            <span class="badge badge-success">Pinned</span>
                        <% } else { %>
                            <span class="badge">Normal</span>
                        <% } %>
                    </td>
                    <td>
                        <form action="/admin/posts/pin/<%= post.id %>" method="POST" style="display: inline;">
                            <button type="submit" class="btn <%= post.isPinned ? 'btn-warning' : 'btn-info' %> btn-sm" title="<%= post.isPinned ? (typeof t !== 'undefined' ? t('admin.posts.unpin') : 'Unpin') : (typeof t !== 'undefined' ? t('admin.posts.pin') : 'Pin') %>">
                                <i class="fas fa-thumbtack"></i> <%= post.isPinned ? (typeof t !== 'undefined' ? t('admin.posts.unpin') : 'Unpin') : (typeof t !== 'undefined' ? t('admin.posts.pin') : 'Pin') %>
                            </button>
                        </form>
                        <a href="/admin/posts/edit/<%= post.id %>" class="btn btn-secondary btn-sm">
                            <i class="fas fa-edit"></i> <%= typeof t !== 'undefined' ? t('admin.posts.edit') : 'Edit' %>
                        </a>
                        <form action="/admin/posts/delete/<%= post.id %>" method="POST" style="display: inline;" onsubmit="return confirm('<%= typeof t !== 'undefined' ? t('admin.posts.confirmDelete') : 'Are you sure you want to delete this post?' %>');">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i> <%= typeof t !== 'undefined' ? t('admin.posts.delete') : 'Delete' %>
                            </button>
                        </form>
                    </td>
                </tr>
            <% }); %>
            <% if (posts.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center"><%= typeof t !== 'undefined' ? t('admin.posts.empty') : 'No posts found' %></td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('partials/admin-footer') %>
