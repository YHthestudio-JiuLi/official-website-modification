<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' && title ? title + ' - ' : '' %>YHthestudio</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <i class="fas fa-cube"></i>
                <span>YHthestudio</span>
            </div>
            <ul class="nav-menu">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/products" class="nav-link">Products</a></li>
                <li><a href="/forum" class="nav-link">Forum</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <li><a href="/orders" class="nav-link"><i class="fas fa-shopping-cart"></i> My Orders</a></li>
                    <li class="nav-user">
                        <span class="user-name"><i class="fas fa-user"></i> <%= user.username %></span>
                        <a href="/logout" class="nav-link logout">Logout</a>
                    </li>
                <% } else { %>
                    <li><a href="/login" class="nav-link">Login</a></li>
                    <li><a href="/register" class="nav-link btn-primary">Register</a></li>
                <% } %>
            </ul>
            <div class="nav-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>
    <main class="main-content">


