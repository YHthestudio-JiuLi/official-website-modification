<%- include('partials/header', { title: 'My Orders', user: user }) %>

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-receipt"></i> My Orders</h1>
    </div>
</div>

<div class="orders-page">
    <div class="container">
        <% if (orders.length === 0) { %>
            <div class="empty-orders">
                <i class="fas fa-shopping-cart"></i>
                <h3>No Orders</h3>
                <p>You don't have any orders yet</p>
                <a href="/products" class="btn btn-primary">Go Shopping</a>
            </div>
        <% } else { %>
            <div class="orders-filter">
                <span>Total <strong><%= orders.length %></strong> orders</span>
            </div>
            <div class="orders-list">
                <% orders.forEach(function(order) { %>
                    <div class="order-card">
                        <div class="order-header">
                            <div class="order-id">
                                <span>Order #: </span>
                                <strong>#<%= order.id %></strong>
                            </div>
                            <span class="status-badge status-<%= order.status %>">
                                <% if (order.status === 'pending') { %>
                                    <i class="fas fa-clock"></i> Pending Payment
                                <% } else if (order.status === 'paid') { %>
                                    <i class="fas fa-check"></i> Paid
                                <% } else if (order.status === 'completed') { %>
                                    <i class="fas fa-check-double"></i> Completed
                                <% } else if (order.status === 'cancelled') { %>
                                    <i class="fas fa-times"></i> Cancelled
                                <% } %>
                            </span>
                        </div>
                        <div class="order-body">
                            <div class="order-product">
                                <h3><i class="fas fa-box"></i> <%= order.productName %></h3>
                                <div class="order-details">
                                    <p><i class="fas fa-hashtag"></i> Order #: <strong>#<%= order.id %></strong></p>
                                    <p><i class="fas fa-shopping-bag"></i> Quantity: <strong><%= order.quantity %></strong></p>
                                    <p><i class="fas fa-dollar-sign"></i> Unit Price: <strong><%= order.price %> USDT</strong></p>
                                    <% if (order.txHash) { %>
                                        <p><i class="fas fa-link"></i> Transaction Hash: <code class="tx-hash"><%= order.txHash %></code></p>
                                    <% } %>
                                </div>
                            </div>
                            <div class="order-amount">
                                <span class="amount-label">Total: </span>
                                <span class="amount-value"><%= order.totalAmount %> USDT</span>
                            </div>
                        </div>
                        <div class="order-footer">
                            <div class="order-dates">
                                <div class="order-date">
                                    <i class="fas fa-calendar-plus"></i>
                                    <span>Created At: <%= new Date(order.createdAt).toLocaleString('en-US') %></span>
                                </div>
                                <% if (order.paidAt) { %>
                                    <div class="order-date">
                                        <i class="fas fa-check-circle"></i>
                                        <span>Paid At: <%= new Date(order.paidAt).toLocaleString('en-US') %></span>
                                    </div>
                                <% } %>
                                <% if (order.completedAt) { %>
                                    <div class="order-date">
                                        <i class="fas fa-check-double"></i>
                                        <span>Completed At: <%= new Date(order.completedAt).toLocaleString('en-US') %></span>
                                    </div>
                                <% } %>
                            </div>
                            <div class="order-actions">
                                <% if (order.status === 'pending') { %>
                                    <a href="/orders/<%= order.id %>/pay" class="btn btn-primary btn-sm">
                                        <i class="fas fa-credit-card"></i> Pay Now
                                    </a>
                                <% } else if (order.status === 'paid') { %>
                                    <span class="status-text status-paid">
                                        <i class="fas fa-hourglass-half"></i> Processing...
                                    </span>
                                <% } else if (order.status === 'completed') { %>
                                    <span class="status-text status-completed">
                                        <i class="fas fa-check-circle"></i> Completed
                                    </span>
                                <% } else if (order.status === 'cancelled') { %>
                                    <span class="status-text status-cancelled">
                                        <i class="fas fa-times-circle"></i> Cancelled
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>

